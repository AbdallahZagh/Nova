<UserControl x:Class="NovaTaskflow.Controls.GanttTrack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Canvas x:Name="Track" Height="32" SizeChanged="Changed" DataContextChanged="ChangedContext"
            Background="{ThemeResource NovaButton}">
        <Border x:Name="Bar" Height="10" Canvas.Top="11" CornerRadius="5" Background="{ThemeResource NovaAccent}"/>
        <Border x:Name="Today" Width="2" Height="32" Background="{ThemeResource NovaText}" Opacity="0.55"/>
    </Canvas>
</UserControl>
