<UserControl x:Class="NovaTaskflow.Controls.WorkspaceSearch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="18,0,18,18" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="Query" PlaceholderText="Search the workspace…" Padding="36,8,10,8"
                     AutomationProperties.Name="Search the workspace"/>
            <FontIcon Glyph="&#xE721;" FontSize="15" IsHitTestVisible="False" HorizontalAlignment="Left"
                      Foreground="{ThemeResource NovaMuted}" Margin="12,0,0,0"/>
            <Button x:Name="Clear" Grid.Column="1" Content="Clear" Style="{StaticResource NovaQuiet}" Visibility="Collapsed"/>
        </Grid>
        <Grid Grid.Row="1" MinHeight="72" MaxHeight="410">
            <ListView x:Name="Results" SelectionMode="Single" IsItemClickEnabled="True" Visibility="Collapsed"
                      ItemContainerStyle="{StaticResource NovaRowContainer}" AutomationProperties.Name="Search results">
                <ListView.GroupStyle><GroupStyle HeaderTemplate="{StaticResource NovaListGroup}"/></ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource NovaCard}" Padding="10,8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource NovaIconTile}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{Binding Glyph}" Foreground="{ThemeResource NovaAccentText}" FontSize="16"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Item.Detail}" Style="{StaticResource NovaSubtitle}" Visibility="{Binding DetailVisibility}"
                                               MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="Status" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing x:Name="Progress" Width="16" Height="16" Visibility="Collapsed"/>
                <TextBlock x:Name="Hint" Text="Start typing to search" Style="{StaticResource NovaSubtitle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
