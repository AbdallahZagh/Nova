<UserControl x:Class="NovaTaskflow.Controls.NoteWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Toolbar" Padding="19,10" ColumnSpacing="12"
              BorderBrush="{ThemeResource NovaBorder}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button x:Name="BackButton" Click="Back" Width="40" Height="40" Padding="0"
                    AutomationProperties.Name="Back to notes" ToolTipService.ToolTip="Back to notes">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <Grid Grid.Column="1" ColumnSpacing="7" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Notes" Style="{StaticResource NovaSubtitle}"/>
                    <FontIcon Glyph="&#xE974;" FontSize="10" Foreground="{ThemeResource NovaMuted}"/>
                </StackPanel>
                <TextBlock x:Name="DocumentName" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Grid x:Name="SaveIndicator" Grid.Column="2" ColumnSpacing="7" VerticalAlignment="Center"
                  AutomationProperties.LiveSetting="Polite" AutomationProperties.AccessibilityView="Content">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="SaveDot" Width="6" Height="6" VerticalAlignment="Center"/>
                <TextBlock x:Name="SaveText" Grid.Column="1" Style="{StaticResource NovaSubtitle}" HorizontalAlignment="Left"
                           FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="390"/>
            </Grid>
            <StackPanel x:Name="ToolbarActions" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button x:Name="InspectorShortcut" Click="JumpToDetails" Visibility="Collapsed" Width="40" Height="40" Padding="0"
                        AutomationProperties.Name="Show note details" ToolTipService.ToolTip="Colour, project, and note options">
                    <FontIcon Glyph="&#xE713;" FontSize="15"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid x:Name="Wide" Grid.Row="1" ColumnSpacing="16" Padding="20,16,20,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="302"/></Grid.ColumnDefinitions>
            <Border x:Name="WritingCard" BorderThickness="1" CornerRadius="23">
                <ScrollViewer x:Name="WritingScroll" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" Padding="32,24">
                    <ContentControl x:Name="WritingHost" HorizontalContentAlignment="Stretch"/>
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="InspectorScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="InspectorHost" HorizontalContentAlignment="Stretch"/>
            </ScrollViewer>
        </Grid>
        <ScrollViewer x:Name="Narrow" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Stacked" Padding="14,12,14,16" Spacing="12"/>
        </ScrollViewer>
    </Grid>
</UserControl>
