<UserControl x:Class="NovaTaskflow.Controls.NotificationInbox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ListView x:Name="Cards" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OpenCard"
              HorizontalContentAlignment="Stretch" AutomationProperties.Name="Notification inbox">
        <ListView.GroupStyle><GroupStyle HeaderTemplate="{StaticResource NovaListGroup}"/></ListView.GroupStyle>
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource NovaCard}" Margin="0,0,0,6" Padding="12" BorderBrush="{Binding Outline}"
                        AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" VerticalAlignment="Top">
                            <Border Style="{StaticResource NovaIconTile}">
                                <FontIcon Glyph="{Binding Glyph}" Foreground="{Binding Tone}" FontSize="16"/>
                            </Border>
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource NovaAccentText}" HorizontalAlignment="Right"
                                     VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding UnreadVisibility}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource NovaSubtitle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Category}" Foreground="{Binding Tone}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource NovaSubtitle}" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
