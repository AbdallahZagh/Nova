<UserControl x:Class="NovaTaskflow.Controls.ProjectLibrary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GridView x:Name="Cards" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OpenProject"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              AutomationProperties.Name="Project library">
        <GridView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="304" ItemHeight="228"/>
            </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Margin" Value="0,0,10,10"/>
            </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource NovaCard}" Padding="14">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NovaIconTile}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource NovaAccentText}"/>
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="8"
                                    BorderBrush="{ThemeResource NovaBorder}" BorderThickness="1" Background="{ThemeResource NovaAccentWash}" Padding="8,3">
                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource NovaAccentText}"/>
                            </Border>
                            <Button Grid.Column="2" Style="{StaticResource NovaQuiet}" Padding="7,4" Click="ProjectOptions"
                                    AutomationProperties.Name="Project options" ToolTipService.ToolTip="Project options">
                                <FontIcon Glyph="&#xE712;" FontSize="15"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource NovaSubtitle}" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="5">
                            <TextBlock Text="{Binding Work}" Style="{StaticResource NovaSubtitle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Value="{Binding Completion}" Foreground="{ThemeResource NovaAccentText}"
                                         AutomationProperties.Name="Project completion percentage"/>
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <PersonPicture Width="24" Height="24" DisplayName="{Binding Owner}" ProfilePicture="{Binding Avatar}"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Owner}" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource NovaSubtitle}" FontSize="11"/>
                            </Grid>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Schedule}" Style="{StaticResource NovaSubtitle}" FontSize="11"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</UserControl>
