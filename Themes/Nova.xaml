    <FontFamily x:Key="NovaFont">Segoe UI Variable Text</FontFamily>
    <BitmapImage x:Key="NovaLogo" UriSource="ms-appx:///Assets/Square150x150Logo.png"/>
    <Style x:Key="NovaTitle" TargetType="TextBlock">
        <Setter Property="CharacterSpacing" Value="-22"/>
        <Setter Property="FontFamily" Value="{StaticResource NovaFont}" />
        <Setter Property="Foreground" Value="{ThemeResource NovaText}" />
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="NovaSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource NovaMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="NovaQuiet" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NovaButton}"/>
        <Setter Property="Foreground" Value="{ThemeResource NovaText}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NovaBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="NovaPrimary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource NovaAction}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NovaAction}"/>
        <Setter Property="Foreground" Value="{ThemeResource NovaActionText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource NovaQuiet}"/>
    <Style x:Key="NovaDangerButton" TargetType="Button" BasedOn="{StaticResource NovaQuiet}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource NovaDanger}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NovaDanger}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="NovaCommand" TargetType="Button" BasedOn="{StaticResource NovaQuiet}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,5"/>
    </Style>
    <Style x:Key="NovaMetricButton" TargetType="Button" BasedOn="{StaticResource NovaQuiet}">
        <Setter Property="Background" Value="{ThemeResource NovaSurface}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NovaBorder}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style x:Key="NovaNavigation" TargetType="Button" BasedOn="{StaticResource NovaQuiet}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="MinHeight" Value="43"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="NovaNavigationActive" TargetType="Button" BasedOn="{StaticResource NovaNavigation}">
        <Setter Property="Background" Value="{ThemeResource NovaAccentWash}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NovaBorder}"/>
        <Setter Property="Foreground" Value="{ThemeResource NovaAccentText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="NovaIconTile" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{ThemeResource NovaAccentWash}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NovaBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="NovaCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NovaSurface}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NovaBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="NovaHeroCard" TargetType="Border" BasedOn="{StaticResource NovaCard}">
        <Setter Property="Background" Value="{ThemeResource NovaFeature}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NovaBorder}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="NovaInput" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource NovaInput}"/>
    <Style x:Key="NovaNoteField" TargetType="TextBox" BasedOn="{StaticResource NovaInput}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="2,3"/>
    </Style>
    <Style x:Key="NovaStickyField" TargetType="TextBox" BasedOn="{StaticResource NovaNoteField}">
        <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{ThemeResource NovaAccentText}"/>
    </Style>
    <Style TargetType="AutoSuggestBox">
        <Setter Property="TextBoxStyle" Value="{StaticResource NovaInput}"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="12,7,34,7"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="IsTextSearchEnabled" Value="True"/>
    </Style>
    <Style x:Key="NovaCalendar" TargetType="CalendarView">
        <Setter Property="Background" Value="{ThemeResource NovaOverlay}"/>
        <Setter Property="Foreground" Value="{ThemeResource NovaText}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NovaBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="TodayBackground" Value="{ThemeResource NovaAccentWash}"/>
        <Setter Property="TodayForeground" Value="{ThemeResource NovaAccentText}"/>
        <Setter Property="TodaySelectedInnerBorderBrush" Value="{ThemeResource NovaAccent}"/>
        <Setter Property="SelectedBorderBrush" Value="{ThemeResource NovaAccent}"/>
        <Setter Property="SelectedHoverBorderBrush" Value="{ThemeResource NovaAccent}"/>
        <Setter Property="SelectedForeground" Value="{ThemeResource NovaAccentText}"/>
        <Setter Property="CalendarItemBackground" Value="{ThemeResource NovaOverlay}"/>
        <Setter Property="CalendarItemForeground" Value="{ThemeResource NovaText}"/>
        <Setter Property="CalendarItemHoverBackground" Value="{ThemeResource NovaAccentWash}"/>
        <Setter Property="CalendarItemPressedBackground" Value="{ThemeResource NovaAccentWash}"/>
        <Setter Property="OutOfScopeForeground" Value="{ThemeResource NovaMuted}"/>
    </Style>
    <Style TargetType="CalendarDatePicker">
        <Setter Property="CalendarViewStyle" Value="{StaticResource NovaCalendar}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource NovaPrimary}"/>
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource NovaQuiet}"/>
        <Setter Property="CloseButtonStyle" Value="{StaticResource NovaQuiet}"/>
    </Style>
    <Style x:Key="NovaRowContainer" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <DataTemplate x:Key="NovaRow">
        <Border Style="{StaticResource NovaCard}" Padding="15,13">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource NovaSubtitle}" MaxLines="4" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Tag}" Foreground="{ThemeResource NovaAccentText}"
                           FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="NovaBoardTask">
        <Border Style="{StaticResource NovaCard}" CornerRadius="14" Padding="11,10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding PriorityColor}" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Text="{Binding Priority}" Style="{StaticResource NovaSubtitle}" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                           MaxLines="3" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Row="2" ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Due}" Style="{StaticResource NovaSubtitle}" FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="Completed subtasks">
                            <FontIcon Glyph="&#xE9D5;" FontSize="10" Foreground="{ThemeResource NovaMuted}"/>
                            <TextBlock Text="{Binding Checklist}" Style="{StaticResource NovaSubtitle}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="3">
                        <ItemsControl ItemsSource="{Binding People}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <PersonPicture DisplayName="{Binding Name}" ProfilePicture="{Binding Avatar}"
                                               Width="23" Height="23" ToolTipService.ToolTip="{Binding Name}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MorePeople}" Visibility="{Binding MorePeopleVisibility}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource NovaMuted}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="NovaListGroup">
        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource NovaMuted}" FontSize="13" FontWeight="SemiBold" Margin="4,9,4,8"/>
    </DataTemplate>
    <DataTemplate x:Key="NovaGanttRow">
        <Border Style="{StaticResource NovaCard}" Padding="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Dates}" Style="{StaticResource NovaSubtitle}" FontSize="11"/></StackPanel>
                <controls:GanttTrack Grid.Column="1"/>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
