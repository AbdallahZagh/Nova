<Window
    x:Class="NovaTaskflow.Shell.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NovaTaskflow.Controls"
    Title="Nova Taskflow">
    <Grid x:Name="Root" Background="{ThemeResource NovaPage}" KeyDown="OnKeyDown">
        <Grid x:Name="Workspace" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="RailSurface" Background="{ThemeResource NovaPaper}"
                  BorderBrush="{ThemeResource NovaBorder}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="10" Margin="20,17,0,16">
                        <Image Source="{StaticResource NovaLogo}" Width="40" Height="40"/>
                        <StackPanel x:Name="BrandName" VerticalAlignment="Center">
                            <TextBlock Text="NOVA" FontWeight="SemiBold" FontSize="22" Foreground="{ThemeResource NovaAccentText}"/>
                            <TextBlock Text="Taskflow" CharacterSpacing="100" FontSize="11" Foreground="{ThemeResource NovaMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="9,0" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Navigation" Spacing="4" AutomationProperties.Name="Nova navigation">
                            <Button Click="Navigate" Tag="Dashboard"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE80F;" FontSize="16"/><TextBlock Text="Dashboard"/></StackPanel></Button>
                            <Button Click="Navigate" Tag="Projects"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B7;" FontSize="16"/><TextBlock Text="Projects"/></StackPanel></Button>
                            <Button Click="Navigate" Tag="Whiteboard"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE70F;" FontSize="16"/><TextBlock Text="Whiteboards"/></StackPanel></Button>
                            <Button Click="Navigate" Tag="Timeline"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE787;" FontSize="16"/><TextBlock Text="Timeline"/></StackPanel></Button>
                            <Button Click="Navigate" Tag="Subscriptions"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8C7;" FontSize="16"/><TextBlock Text="Subscriptions"/></StackPanel></Button>
                            <Button Click="Navigate" Tag="Notes"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE70B;" FontSize="16"/><TextBlock Text="Notes"/></StackPanel></Button>
                        </StackPanel>
                    </ScrollViewer>
                <StackPanel x:Name="RailFooter" Grid.Row="2" Margin="16,12,16,16" Spacing="7">
                    <Button x:Name="RailProfile" Click="OpenProfile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Style="{StaticResource NovaQuiet}" Padding="9" AutomationProperties.Name="Profile" ToolTipService.ToolTip="Profile">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PersonPicture x:Name="SidebarAvatar" Width="34" Height="34" />
                            <StackPanel x:Name="ProfileLabel" Width="118" VerticalAlignment="Center">
                                <TextBlock x:Name="PersonName" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PersonRole" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NovaMuted}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AdminLink" Click="OpenAdmin" Visibility="Collapsed" AutomationProperties.Name="Administration"
                            ToolTipService.ToolTip="Administration" Style="{StaticResource NovaQuiet}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xEA18;" FontSize="15"/><TextBlock x:Name="AdminLabel" Text="Administration"/>
                        </StackPanel>
                    </Button>
                    <Grid ColumnSpacing="7">
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="LogoutRow" Height="0"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="LogoutColumn" Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="SettingsLink" Click="OpenSettings" Style="{StaticResource NovaQuiet}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE713;" FontSize="14"/><TextBlock x:Name="SettingsLabel" Text="Settings"/></StackPanel>
                        </Button>
                        <Button x:Name="Logout" Grid.Column="1" Click="SignOutClicked" Style="{StaticResource NovaQuiet}" Padding="10,5"
                                AutomationProperties.Name="Log out" ToolTipService.ToolTip="Log out">
                            <FontIcon Glyph="&#xF3B1;" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="CommandBar" Padding="24,10" ColumnSpacing="18" Background="{ThemeResource NovaPaper}"
                      BorderBrush="{ThemeResource NovaBorder}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="SearchButton" Click="OpenSearch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Style="{StaticResource NovaQuiet}" VerticalAlignment="Stretch" Padding="14,0"
                                AutomationProperties.Name="Search">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE721;" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="Search tasks, projects, subscriptions, users..." Foreground="{ThemeResource NovaMuted}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SearchHint" Grid.Column="2" Text="Ctrl K" Foreground="{ThemeResource NovaMuted}" FontSize="11"/>
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Click="OpenStickies" Style="{StaticResource NovaCommand}" Foreground="{ThemeResource NovaAccentText}" AutomationProperties.Name="Stickies"
                                    Background="{ThemeResource NovaAccentWash}" ToolTipService.ToolTip="Open Stickies (Ctrl+Alt+S)">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE70B;" FontSize="14"/><TextBlock x:Name="StickyLabel" Text="Stickies"/></StackPanel>
                            </Button>
                            <Button Click="OpenNotifications" Style="{StaticResource NovaCommand}" AutomationProperties.Name="Notifications" ToolTipService.ToolTip="Notifications">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="16"/>
                                    <InfoBadge x:Name="UnreadBadge" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeButton" Click="ToggleTheme" Style="{StaticResource NovaCommand}" AutomationProperties.Name="Theme">
                                <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="16"/>
                            </Button>
                            <Button x:Name="TopProfile" Click="OpenProfile" ToolTipService.ToolTip="View your profile" AutomationProperties.Name="View your profile" Style="{StaticResource NovaCommand}" Padding="5" CornerRadius="18">
                                <PersonPicture x:Name="TopAvatar" Width="26" Height="26"/>
                            </Button>
                        </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1">
                    <InfoBar x:Name="SystemBanner" IsClosable="False"/>
                    <InfoBar x:Name="SyncBanner" IsClosable="False">
                        <InfoBar.ActionButton>
                            <Button Content="Review changes" Style="{StaticResource NovaQuiet}" Click="OpenOutbox"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="OfflineBanner" Severity="Warning" IsClosable="False"
                             Title="Nova’s server isn’t responding. Your local work is still available."/>
                </StackPanel>
                <Frame x:Name="PageFrame" Grid.Row="2" CacheSize="0" IsNavigationStackEnabled="False"/>
            </Grid>
        </Grid>
        <controls:AuthView x:Name="AuthPane" />
        <Grid x:Name="Overlay" Visibility="Collapsed" Canvas.ZIndex="10">
            <Border Background="#85000000" Tapped="DismissOverlay"/>
            <Border x:Name="OverlayCard" Style="{StaticResource NovaCard}"
                    Background="{ThemeResource NovaOverlay}" HorizontalAlignment="Right" VerticalAlignment="Stretch" Padding="0">
                <ContentControl x:Name="OverlayContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.ContentTransitions>
                        <TransitionCollection><ContentThemeTransition HorizontalOffset="12" VerticalOffset="0"/></TransitionCollection>
                    </ContentControl.ContentTransitions>
                </ContentControl>
            </Border>
        </Grid>
        <InfoBar x:Name="ToastBar" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 MaxWidth="700" MinWidth="280" Margin="20" Canvas.ZIndex="20"/>
    </Grid>
</Window>
