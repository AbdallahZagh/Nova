// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskCommentStatus {
  OPEN
  CLOSED
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String  @unique
  passwordHash String
  fullName     String
  isActive     Boolean @default(false)
  isArchived   Boolean @default(false)
  roleTitle    String?
  bio          String?
  avatarUrl    String?

  ownedProjects      Project[]
  memberOfProjects   ProjectMember[]
  assignedTasks      Task[]
  taskAssignments    TaskAssignment[]
  subtaskAssignments SubtaskAssignment[]
  taskActivities     TaskActivity[]
  taskComments       TaskComment[]
  taskCommentReplies TaskComment[]       @relation("TaskCommentReplier")
  closedTaskComments TaskComment[]       @relation("TaskCommentCloser")
  projectSuggestions ProjectSuggestion[]
  otps               Otp[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Project
// ─────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tasks       Task[]
  members     ProjectMember[]
  suggestions ProjectSuggestion[]

  @@map("projects")
}

model ProjectSuggestion {
  id        String   @id @default(uuid())
  content   String
  status    String   @default("In Review")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("project_suggestions")
}

// ─────────────────────────────────────────────
// ProjectMember  (User <-> Project many-to-many)
// ─────────────────────────────────────────────

model ProjectMember {
  userId    String
  projectId String
  role      ProjectRole @default(MEMBER)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_members")
}

// ─────────────────────────────────────────────
// Task
// ─────────────────────────────────────────────

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("To Do")
  priority    String    @default("Medium")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  subtasks       Subtask[]
  taskActivities TaskActivity[]
  comments       TaskComment[]
  assignments    TaskAssignment[]

  @@map("tasks")
}

model TaskAssignment {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignments")
}

model TaskComment {
  id        String            @id @default(uuid())
  content   String
  status    TaskCommentStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  replyContent String?
  repliedAt    DateTime?
  closedAt     DateTime?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  repliedById String?
  repliedBy   User?   @relation("TaskCommentReplier", fields: [repliedById], references: [id], onDelete: SetNull)

  closedById String?
  closedBy   User?   @relation("TaskCommentCloser", fields: [closedById], references: [id], onDelete: SetNull)

  @@map("task_comments")
}

// ─────────────────────────────────────────────
// Subtask
// ─────────────────────────────────────────────

model Subtask {
  id          String  @id @default(uuid())
  title       String
  isCompleted Boolean @default(false)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  assignments SubtaskAssignment[]

  @@map("subtasks")
}

model SubtaskAssignment {
  subtaskId  String
  userId     String
  assignedAt DateTime @default(now())

  subtask Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([subtaskId, userId])
  @@map("subtask_assignments")
}

// ─────────────────────────────────────────────
// TaskActivity
// ─────────────────────────────────────────────

model TaskActivity {
  id        String   @id @default(uuid())
  type      String
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("task_activities")
}

// ─────────────────────────────────────────────
// Otp
// ─────────────────────────────────────────────

model Otp {
  id        String   @id @default(uuid())
  code      String
  purpose   String   @default("REGISTER")
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}
