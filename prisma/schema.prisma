// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskCommentStatus {
  OPEN
  CLOSED
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String  @unique
  passwordHash String
  fullName     String
  isActive     Boolean @default(false)
  isArchived   Boolean @default(false)
  isDemo       Boolean @default(false)
  roleTitle    String?
  bio          String?
  avatarUrl    String?

  ownedProjects      Project[]
  memberOfProjects   ProjectMember[]
  assignedTasks      Task[]
  taskAssignments    TaskAssignment[]
  subtaskAssignments SubtaskAssignment[]
  taskActivities     TaskActivity[]
  taskComments       TaskComment[]
  taskCommentReplies TaskComment[]       @relation("TaskCommentReplier")
  closedTaskComments TaskComment[]       @relation("TaskCommentCloser")
  projectSuggestions ProjectSuggestion[]
  notifications          Notification[]
  deviceTokens           UserDeviceToken[]
  otps                   Otp[]
  whiteboards            Whiteboard[]
  whiteboardMemberships  WhiteboardMember[]
  lastEditedWhiteboards  Whiteboard[]          @relation("WhiteboardLastEditor")
  whiteboardActivities   WhiteboardActivity[]
  whiteboardComments     WhiteboardComment[]
  whiteboardInvitesCreated WhiteboardInvite[]  @relation("WhiteboardInviteCreator")
  whiteboardInvitesUsed    WhiteboardInvite[]  @relation("WhiteboardInviteUser")

  @@map("users")
}

// ─────────────────────────────────────────────
// Project
// ─────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tasks       Task[]
  members     ProjectMember[]
  suggestions ProjectSuggestion[]
  whiteboards Whiteboard[]

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model ProjectSuggestion {
  id        String   @id @default(uuid())
  content   String
  status    String   @default("In Review")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  mentionedUserIds Json @default("[]")

  @@index([projectId])
  @@map("project_suggestions")
}

// ─────────────────────────────────────────────
// ProjectMember  (User <-> Project many-to-many)
// ─────────────────────────────────────────────

model ProjectMember {
  userId    String
  projectId String
  role      ProjectRole @default(MEMBER)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_members")
}

// ─────────────────────────────────────────────
// Task
// ─────────────────────────────────────────────

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("To Do")
  priority    String    @default("Medium")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  subtasks       Subtask[]
  taskActivities TaskActivity[]
  comments       TaskComment[]
  assignments    TaskAssignment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([status])
  @@index([projectId, status])
  @@map("tasks")
}

model TaskAssignment {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignments")
}

model TaskComment {
  id        String            @id @default(uuid())
  content   String
  status    TaskCommentStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  replyContent String?
  repliedAt    DateTime?
  closedAt     DateTime?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  repliedById String?
  repliedBy   User?   @relation("TaskCommentReplier", fields: [repliedById], references: [id], onDelete: SetNull)

  closedById String?
  closedBy   User?   @relation("TaskCommentCloser", fields: [closedById], references: [id], onDelete: SetNull)

  mentionedUserIds Json @default("[]")
  replyMentionedUserIds Json @default("[]")

  @@index([taskId])
  @@map("task_comments")
}

// ─────────────────────────────────────────────
// Subtask
// ─────────────────────────────────────────────

model Subtask {
  id          String    @id @default(uuid())
  title       String
  isCompleted Boolean   @default(false)
  dueDate     DateTime?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  assignments SubtaskAssignment[]

  @@index([taskId])
  @@map("subtasks")
}

model SubtaskAssignment {
  subtaskId  String
  userId     String
  assignedAt DateTime @default(now())

  subtask Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([subtaskId, userId])
  @@map("subtask_assignments")
}

// ─────────────────────────────────────────────
// TaskActivity
// ─────────────────────────────────────────────

model TaskActivity {
  id        String   @id @default(uuid())
  type      String
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_activities")
}

// ─────────────────────────────────────────────
// Otp
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO")
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notification")
}

model UserDeviceToken {
  id         String   @id @default(uuid())
  token      String   @unique
  platform   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_device_tokens")
}

model Otp {
  id        String   @id @default(uuid())
  code      String
  purpose   String   @default("REGISTER")
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

// ─────────────────────────────────────────────
// Whiteboard
// ─────────────────────────────────────────────

enum WhiteboardRole {
  ADMIN
  MEMBER
  VIEWER
}

model Whiteboard {
  id        String   @id @default(uuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  lastEditedAt   DateTime?
  lastEditedById String?
  lastEditedBy   User?    @relation("WhiteboardLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)

  duplicatedFromId String?

  pages      WhiteboardPage[]
  members    WhiteboardMember[]
  activities WhiteboardActivity[]
  comments   WhiteboardComment[]
  invites    WhiteboardInvite[]

  @@index([projectId])
  @@index([createdById])
  @@index([lastEditedById])
  @@map("whiteboards")
}

model WhiteboardActivity {
  id        String   @id @default(uuid())
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([whiteboardId, createdAt])
  @@index([whiteboardId, actorId, type, createdAt])
  @@map("whiteboard_activities")
}

model WhiteboardComment {
  id               String   @id @default(uuid())
  content          String
  pageId           String?
  x                Float?
  y                Float?
  mentionedUserIds Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([whiteboardId, createdAt])
  @@map("whiteboard_comments")
}

model WhiteboardInvite {
  id        String         @id @default(uuid())
  token     String         @unique
  role      WhiteboardRole
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("WhiteboardInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  usedById String?
  usedBy   User?   @relation("WhiteboardInviteUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([token])
  @@map("whiteboard_invites")
}

model WhiteboardPage {
  id           String   @id @default(uuid())
  index        Int      @default(0)
  documentJson Json
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  snapshot WhiteboardPageSnapshot?

  @@index([whiteboardId])
  @@map("whiteboard_pages")
}

model WhiteboardPageSnapshot {
  id          String         @id @default(uuid())
  pageId      String         @unique
  page        WhiteboardPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  imageUrl    String
  storagePath String
  width       Int
  height      Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("whiteboard_page_snapshots")
}

model WhiteboardMember {
  userId       String
  whiteboardId String
  role         WhiteboardRole @default(MEMBER)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  whiteboard Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  @@id([userId, whiteboardId])
  @@map("whiteboard_members")
}
