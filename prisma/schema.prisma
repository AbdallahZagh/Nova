// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskCommentStatus {
  OPEN
  CLOSED
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketCategory {
  BUG
  FEATURE_REQUEST
  ACCOUNT
  OTHER
}

enum SupportReplyChannel {
  EMAIL
  INTERNAL
}

enum AdminBroadcastScope {
  USER
  PROJECT
  ALL
}

enum AiFeature {
  PROJECT_DESCRIPTION
  TASK_SUGGEST
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String    @unique
  passwordHash     String
  fullName         String
  isActive         Boolean   @default(false)
  isArchived       Boolean   @default(false)
  isDemo           Boolean   @default(false)
  role             UserRole  @default(USER)
  roleTitle        String?
  bio              String?
  avatarUrl        String?
  lastActiveAt     DateTime?
  tokensValidAfter DateTime?
  createdAt        DateTime  @default(now())

  ownedProjects      Project[]
  memberOfProjects   ProjectMember[]
  assignedTasks      Task[]
  taskAssignments    TaskAssignment[]
  subtaskAssignments SubtaskAssignment[]
  taskActivities     TaskActivity[]
  taskComments       TaskComment[]
  taskCommentReplies TaskComment[]       @relation("TaskCommentReplier")
  closedTaskComments TaskComment[]       @relation("TaskCommentCloser")
  projectSuggestions ProjectSuggestion[]
  notifications          Notification[]
  deviceTokens           UserDeviceToken[]
  otps                   Otp[]
  whiteboards            Whiteboard[]
  whiteboardMemberships  WhiteboardMember[]
  lastEditedWhiteboards  Whiteboard[]          @relation("WhiteboardLastEditor")
  whiteboardActivities   WhiteboardActivity[]
  whiteboardComments     WhiteboardComment[]
  whiteboardInvitesCreated WhiteboardInvite[]  @relation("WhiteboardInviteCreator")
  whiteboardInvitesUsed    WhiteboardInvite[]  @relation("WhiteboardInviteUser")
  auditLogs                AuditLog[]
  supportTickets           SupportTicket[]
  supportReplies           SupportReply[]
  demoSessions             DemoSession[]
  demoEvents               DemoEvent[]
  aiUsage                  AiUsage[]
  aiQuota                  AiUserQuota?
  broadcastsCreated        AdminBroadcast[]

  @@index([role, isActive, isArchived])
  @@index([lastActiveAt])
  @@map("users")
}

// ─────────────────────────────────────────────
// Project
// ─────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tasks       Task[]
  members     ProjectMember[]
  suggestions ProjectSuggestion[]
  whiteboards Whiteboard[]

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model ProjectSuggestion {
  id        String   @id @default(uuid())
  content   String
  status    String   @default("In Review")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  mentionedUserIds Json @default("[]")

  @@index([projectId])
  @@map("project_suggestions")
}

// ─────────────────────────────────────────────
// ProjectMember  (User <-> Project many-to-many)
// ─────────────────────────────────────────────

model ProjectMember {
  userId    String
  projectId String
  role      ProjectRole @default(MEMBER)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_members")
}

// ─────────────────────────────────────────────
// Task
// ─────────────────────────────────────────────

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("To Do")
  priority    String    @default("Medium")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  subtasks       Subtask[]
  taskActivities TaskActivity[]
  comments       TaskComment[]
  assignments    TaskAssignment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([status])
  @@index([projectId, status])
  @@map("tasks")
}

model TaskAssignment {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignments")
}

model TaskComment {
  id        String            @id @default(uuid())
  content   String
  status    TaskCommentStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  replyContent String?
  repliedAt    DateTime?
  closedAt     DateTime?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  repliedById String?
  repliedBy   User?   @relation("TaskCommentReplier", fields: [repliedById], references: [id], onDelete: SetNull)

  closedById String?
  closedBy   User?   @relation("TaskCommentCloser", fields: [closedById], references: [id], onDelete: SetNull)

  mentionedUserIds Json @default("[]")
  replyMentionedUserIds Json @default("[]")

  @@index([taskId])
  @@map("task_comments")
}

// ─────────────────────────────────────────────
// Subtask
// ─────────────────────────────────────────────

model Subtask {
  id          String    @id @default(uuid())
  title       String
  isCompleted Boolean   @default(false)
  dueDate     DateTime?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  assignments SubtaskAssignment[]

  @@index([taskId])
  @@map("subtasks")
}

model SubtaskAssignment {
  subtaskId  String
  userId     String
  assignedAt DateTime @default(now())

  subtask Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([subtaskId, userId])
  @@map("subtask_assignments")
}

// ─────────────────────────────────────────────
// TaskActivity
// ─────────────────────────────────────────────

model TaskActivity {
  id        String   @id @default(uuid())
  type      String
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_activities")
}

// ─────────────────────────────────────────────
// Otp
// ─────────────────────────────────────────────

model Notification {
  id          String    @id @default(uuid())
  title       String
  message     String
  type        String    @default("INFO")
  metadata    Json?
  isRead      Boolean   @default(false)
  openedAt    DateTime?
  broadcastId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast AdminBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([broadcastId])
  @@map("notification")
}

model UserDeviceToken {
  id         String   @id @default(uuid())
  token      String   @unique
  platform   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_device_tokens")
}

model Otp {
  id        String   @id @default(uuid())
  code      String
  purpose   String   @default("REGISTER")
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

// ─────────────────────────────────────────────
// Whiteboard
// ─────────────────────────────────────────────

enum WhiteboardRole {
  ADMIN
  MEMBER
  VIEWER
}

model Whiteboard {
  id        String   @id @default(uuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  lastEditedAt   DateTime?
  lastEditedById String?
  lastEditedBy   User?    @relation("WhiteboardLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)

  autoSaveSnapshotOnExit Boolean @default(false)

  duplicatedFromId String?

  pages      WhiteboardPage[]
  members    WhiteboardMember[]
  activities WhiteboardActivity[]
  comments   WhiteboardComment[]
  invites    WhiteboardInvite[]

  @@index([projectId])
  @@index([createdById])
  @@index([lastEditedById])
  @@map("whiteboards")
}

model WhiteboardActivity {
  id        String   @id @default(uuid())
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([whiteboardId, createdAt])
  @@index([whiteboardId, actorId, type, createdAt])
  @@map("whiteboard_activities")
}

model WhiteboardComment {
  id               String   @id @default(uuid())
  content          String
  pageId           String?
  x                Float?
  y                Float?
  mentionedUserIds Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([whiteboardId, createdAt])
  @@map("whiteboard_comments")
}

model WhiteboardInvite {
  id        String         @id @default(uuid())
  token     String         @unique
  role      WhiteboardRole
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("WhiteboardInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  usedById String?
  usedBy   User?   @relation("WhiteboardInviteUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([token])
  @@map("whiteboard_invites")
}

model WhiteboardPage {
  id           String   @id @default(uuid())
  index        Int      @default(0)
  documentJson Json
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  snapshot WhiteboardPageSnapshot?

  @@index([whiteboardId])
  @@map("whiteboard_pages")
}

model WhiteboardPageSnapshot {
  id          String         @id @default(uuid())
  pageId      String         @unique
  page        WhiteboardPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  imageUrl    String
  storagePath String
  width       Int
  height      Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("whiteboard_page_snapshots")
}

model WhiteboardMember {
  userId       String
  whiteboardId String
  role         WhiteboardRole @default(MEMBER)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  whiteboard Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  @@id([userId, whiteboardId])
  @@map("whiteboard_members")
}

model SystemSettings {
  id                         String   @id @default("default")
  maintenanceMode            Boolean  @default(false)
  broadcastBanner            String?
  aiEnabled                  Boolean  @default(true)
  defaultAiDailyQuota        Int      @default(20)
  registrationsEnabled       Boolean  @default(true)
  fcmEnabled                 Boolean  @default(true)
  whiteboardRealtimeEnabled  Boolean  @default(true)
  updatedAt                  DateTime @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SupportTicket {
  id         String                 @id @default(uuid())
  title      String
  body       String
  status     SupportTicketStatus    @default(OPEN)
  priority   SupportTicketPriority  @default(NORMAL)
  category   SupportTicketCategory  @default(OTHER)
  route      String?
  appVersion String?
  platform   String?
  userAgent  String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  attachments SupportAttachment[]
  replies     SupportReply[]

  @@index([status, priority, createdAt])
  @@index([userId, createdAt])
  @@map("support_tickets")
}

model SupportAttachment {
  id          String   @id @default(uuid())
  storagePath String
  imageUrl    String
  createdAt   DateTime @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_attachments")
}

model SupportReply {
  id        String              @id @default(uuid())
  channel   SupportReplyChannel
  body      String
  createdAt DateTime            @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_replies")
}

model DemoSession {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  platform       String?
  appVersion     String?
  visitorHash    String?
  requestCount   Int       @default(0)
  mutationCount  Int       @default(0)
  blockedCount   Int       @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  events DemoEvent[]

  @@index([userId, startedAt])
  @@index([startedAt])
  @@map("demo_sessions")
}

model DemoEvent {
  id         String   @id @default(uuid())
  action     String
  ok         Boolean  @default(true)
  route      String?
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  sessionId String
  session   DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("demo_events")
}

model DemoDaySummary {
  id              String   @id @default(uuid())
  day             DateTime
  sessionCount    Int      @default(0)
  uniqueVisitors  Int      @default(0)
  mutationCount   Int      @default(0)
  blockedCount    Int      @default(0)
  topActions      Json?
  topBlocks       Json?
  seedDiff        Json?
  createdAt       DateTime @default(now())

  @@unique([day])
  @@map("demo_day_summaries")
}

model AiUsage {
  id           String    @id @default(uuid())
  feature      AiFeature
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  latencyMs    Int       @default(0)
  ok           Boolean   @default(true)
  createdAt    DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

model AiUserQuota {
  userId      String @id
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLimit  Int
  updatedAt   DateTime @updatedAt

  @@map("ai_user_quotas")
}

model AdminBroadcast {
  id              String              @id @default(uuid())
  scope           AdminBroadcastScope
  targetUserId    String?
  targetProjectId String?
  title           String
  body            String
  actionUrl       String?
  inApp           Boolean             @default(true)
  fcm             Boolean             @default(false)
  email           Boolean             @default(false)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  createdAt       DateTime            @default(now())

  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  deliveries  AdminBroadcastDelivery[]
  notifications Notification[]

  @@index([createdAt])
  @@map("admin_broadcasts")
}

model AdminBroadcastDelivery {
  id        String   @id @default(uuid())
  channel   String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  broadcastId String
  broadcast   AdminBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String

  @@index([broadcastId])
  @@map("admin_broadcast_deliveries")
}

model HttpMetricRollup {
  minuteStart DateTime @id
  count       Int      @default(0)
  errorCount  Int      @default(0)
  latencySum  Int      @default(0)

  @@map("http_metric_rollups")
}

model CronJobRun {
  name           String    @id
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastStatus     String?
  lastError      String?

  @@map("cron_job_runs")
}

